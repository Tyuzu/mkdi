---
layout: layout.liquid
---
<article class="post">
    <header class="post-header">
        {% if heroImage %}
            <img src="{{ heroImage }}" alt="{{ heroAlt | default: pageTitle }}">
        {% endif %}

        <h1>{{ pageTitle }}</h1>

        {% if subtitle %}
            <p class="subtitle">{{ subtitle }}</p>
        {% endif %}

        <div class="post-meta">
            <time datetime="{{ page.date | date: '%Y-%m-%d' }}">
                {{ page.date | date: "%Y-%m-%d" }}
            </time>
            {% if author %} · <span>{{ author }}</span>{% endif %}
        </div>
    </header>

    <div class="post-body">
        {{ content }}
    </div>
</article>