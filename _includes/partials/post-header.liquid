<header class="post-header">
    {% if heroImage %}
        <img src="{{ heroImage }}" alt="{{ heroAlt | default: pageTitle }}">
    {% endif %}

    <h1>{{ pageTitle }}</h1>

    {% if subtitle %}
        <p class="subtitle">{{ subtitle }}</p>
    {% endif %}

    <div class="post-meta">
        <time datetime="{{ date | date: '%Y-%m-%d' }}">
            {{ date | date: "%Y-%m-%d" }}
        </time>
        {% if author %} · <span>{{ author }}</span>{% endif %}
    </div>
</header>