<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% if pageTitle %}{{ pageTitle }} | My Blog{% else %}My Blog{% endif %}</title>
        {% if description %}
            <meta name="description" content="{{ description }}">
        {% endif %}
    </head>
    <body>
        <nav>
            <a href="/">Home</a>
            {% for pg in collections.pages %}
                <a href="{{ pg.url }}">{{ pg.data.navTitle | default: pg.data.pageTitle }}</a>
            {% endfor %}
        </nav>

        <main>
            {{ content }}
        </main>
    </body>
</html>