<!DOCTYPE html>
<html lang="en">
    <head>
        {%- render 'partials/head.liquid',
            pageTitle: pageTitle,
            description: description,
            styles: styles,
            scripts: scripts,
            headHtml: headHtml
        -%}
    </head>
    <body>
        {%- render 'partials/header.liquid', pageTitle: pageTitle -%}
        {%- render 'partials/nav.liquid', pages: collections.pages, currentUrl: page.url -%}
        {%- render 'partials/sidebar.liquid', tags: tags, url: page.url -%}
        <main>
            {{ content }}
        </main>
        {%- capture currentYear -%}{{ page.date | date: "%Y" }}{%- endcapture -%}
        {%- render 'partials/footer.liquid', year: currentYear -%}
    </body>
</html>